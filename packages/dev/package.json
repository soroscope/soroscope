{
  "name": "@soroscope/dev",
  "version": "0.1.0",
  "description": "Run Soroban contracts in-process inside soroban-env-host: rebuild and hot-swap on save, call by name from a prompt. No network, no Docker.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:engine": "cargo build --release --manifest-path engine/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "test:engine": "vitest run --config vitest.engine.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "keywords": [
    "stellar",
    "soroban",
    "devtools"
  ],
  "author": "blockchain-maxis (https://github.com/blockchain-maxis)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroscope/soroscope.git",
    "directory": "packages/dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@orbital-stellar/abi-registry": "0.2.0",
    "@soroscope/core": "workspace:*",
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "tsup": "^9.0.0"
  }
}
